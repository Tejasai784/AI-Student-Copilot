# ==============================================================================
# Autonomous Student Intelligence Platform (ASIP V2.0) - Environment Config
# ==============================================================================

# Application Environment
APP_ENV=production
DEBUG=false
APP_PORT=8000

# AI Provider API Keys (At least one key required for AI features)
# Google Gemini (Primary high-throughput provider)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (Secondary automatic circuit-breaker fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_64_char_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite with WAL mode by default)
DATABASE_URL=sqlite:///./data/ai_student_copilot.db

# Storage Limits
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
